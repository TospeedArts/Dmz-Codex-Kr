{
  "manifest_version": 3,
  "name": "DMZ Codex 한글 지도 (MW4 하진)",
  "version": "1.0",
  "description": "dmzcodex.com의 MW4 DMZ 하진 지도·위치·전리품 페이지를 한글로 바꿔 보여주고, 검색창에 한글로 검색할 수 있으며, 지도 아이콘에 마우스를 올리면 한글 이름을 보여줍니다.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "DMZ 한글 지도",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dmzcodex.com/*",
        "https://www.dmzcodex.com/*"
      ],
      "js": [
        "dictionary.js",
        "search-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "exclude_matches": [
        "https://dmzcodex.com/fr/*",
        "https://dmzcodex.com/de/*",
        "https://dmzcodex.com/it/*",
        "https://dmzcodex.com/es/*",
        "https://dmzcodex.com/ar/*",
        "https://www.dmzcodex.com/fr/*",
        "https://www.dmzcodex.com/de/*",
        "https://www.dmzcodex.com/it/*",
        "https://www.dmzcodex.com/es/*",
        "https://www.dmzcodex.com/ar/*"
      ]
    },
    {
      "matches": [
        "https://dmzcodex.com/*",
        "https://www.dmzcodex.com/*"
      ],
      "js": [
        "dictionary.js",
        "translator.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://dmzcodex.com/fr/*",
        "https://dmzcodex.com/de/*",
        "https://dmzcodex.com/it/*",
        "https://dmzcodex.com/es/*",
        "https://dmzcodex.com/ar/*",
        "https://www.dmzcodex.com/fr/*",
        "https://www.dmzcodex.com/de/*",
        "https://www.dmzcodex.com/it/*",
        "https://www.dmzcodex.com/es/*",
        "https://www.dmzcodex.com/ar/*"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}